# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# AvalAI
AVALAI_API_KEY=your-avalai-api-key
# Native Gemini base URL (no /v1). Used by Google GenAI SDK.
AVALAI_BASE_URL=https://api.avalai.ir
# OpenAI-compatible base URL (must include /v1). Used for chat/structured text.
AVALAI_OPENAI_BASE_URL=https://api.avalai.ir/v1

# Model
MODEL=gemini-3.1-pro-preview
# Text/structured extraction backend: auto | openai | native
# auto tries OpenAI-compatible first, then falls back to native GenAI.
TEXT_GENERATION_BACKEND=auto

# Database (SQLAlchemy URL; SQLite by default, PostgreSQL-ready)
DATABASE_URL=sqlite:///bot.db

# Optional: separate transcription provider (disabled by default).
# Only used when ENABLE_FALLBACK_TRANSCRIPTION=true AND Gemini audio fails.
# Do not silently route paid traffic here.
ENABLE_FALLBACK_TRANSCRIPTION=false
FALLBACK_TRANSCRIPTION_BASE_URL=
FALLBACK_TRANSCRIPTION_API_KEY=
FALLBACK_TRANSCRIPTION_MODEL=

# Paths — authoritative FRN template (copy of FRN..Work-Report.xlsx)
EXCEL_TEMPLATE_PATH=templates/weekly_report.xlsx
EXCEL_MAPPING_PATH=templates/weekly_report_mapping.json
OUTPUT_DIR=outputs
TEMP_AUDIO_DIR=temp_audio

# Limits
MAX_AUDIO_BYTES=20971520
API_TIMEOUT_SECONDS=120
API_MAX_RETRIES=3

# Logging
LOG_LEVEL=INFO
LOG_TRANSCRIPTIONS=false
